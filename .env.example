# Copy to .env and fill in. Never commit .env.

# Choose a provider: openai | gemini | custom
# gemini has a free tier (Google AI Studio key: https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini

OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# Optional overrides. Leave commented to use the provider defaults
# (openai: gpt-4.1-mini then gpt-4.1-nano. gemini: gemini-3.8-flash then gemini-3.5-flash-lite).
# PRIMARY_MODEL=
# FALLBACK_MODEL=

# For LLM_PROVIDER=custom (any OpenAI-compatible API such as Groq or OpenRouter):
# LLM_API_KEY=
# LLM_BASE_URL=https://example.com/v1
# PRIMARY_MODEL=
# FALLBACK_MODEL=

REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
RETRY_MIN_WAIT_SECONDS=1
RETRY_MAX_WAIT_SECONDS=8

# Prices in USD per 1 million tokens, only needed to override defaults.
# Defaults: OpenAI placeholders (verify on the pricing page), Gemini free tier = 0.
# PRIMARY_INPUT_PRICE_PER_M=
# PRIMARY_OUTPUT_PRICE_PER_M=
# FALLBACK_INPUT_PRICE_PER_M=
# FALLBACK_OUTPUT_PRICE_PER_M=
